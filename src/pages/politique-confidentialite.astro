---
/**
 * Politique de Confidentialité Redesign
 * 
 * Page légale RGPD avec design Synthwave minimal
 * 100% Astro pur (0 KB JS)
 */

import LayoutRedesign from '../layouts/LayoutRedesign.astro';
import { GridBackground } from '../components/redesign/layout/GridBackground';
import Header from '../components/redesign/layout/Header';
import Footer from '../components/redesign/layout/Footer.astro';
import { Shield, ArrowLeft } from 'lucide-react';

const title = "Politique de Confidentialité | Protection Données PIXEL CLASH";
const description = "Politique de confidentialité PIXEL CLASH. Comment nous collectons, utilisons et protégeons vos données personnelles. Conformité RGPD pour le tournoi retrogaming.";
---

<LayoutRedesign title={title} description={description}>
  <div class="min-h-screen bg-bg-dark text-text-light">
    
    <Header client:load currentPath={Astro.url.pathname} />
    <GridBackground client:only="react" />
    
    <div class="pt-16">
      <article class="relative py-20">
        <div class="container mx-auto px-4 relative z-10 max-w-4xl">
          
          <a 
            href="/"
            class="inline-flex items-center gap-2 text-neon-cyan hover:text-neon-magenta transition-colors mb-8"
          >
            <ArrowLeft className="w-4 h-4" />
            Retour à l'accueil
          </a>

          <div class="mb-12">
            <div class="flex items-center gap-3 mb-4">
              <Shield className="w-8 h-8 text-neon-cyan" />
              <h1 class="text-4xl md:text-5xl font-bold">
                <span class="bg-gradient-to-r from-neon-cyan to-neon-magenta bg-clip-text text-transparent">
                  Politique de Confidentialité
                </span>
              </h1>
            </div>
            <p class="text-text-muted">Dernière mise à jour : 25 novembre 2025</p>
          </div>

          <div class="space-y-8">
            <div class="p-6 rounded-xl bg-gradient-to-br from-green-500/10 via-cyan-500/10 to-green-500/10 border border-green-500/30">
              <h2 class="text-xl font-bold text-text-light mb-3">🔒 Engagement RGPD</h2>
              <p class="text-text-muted leading-relaxed">
                PIXEL CLASH s'engage à protéger vos données personnelles conformément au Règlement Général sur la Protection des Données (RGPD) et à la loi Informatique et Libertés.
              </p>
            </div>

            <div class="p-6 rounded-xl bg-bg-dark/40 backdrop-blur-md border border-neon-cyan/20">
              <h2 class="text-2xl font-bold text-text-light mb-4">1. Responsable du traitement</h2>
              <div class="text-text-muted space-y-2">
                <p><strong class="text-neon-cyan">Responsable :</strong> PIXEL CLASH SARL</p>
                <p><strong class="text-neon-cyan">Adresse :</strong> 123 Avenue des Champs-Élysées, 75008 Paris</p>
                <p><strong class="text-neon-cyan">Email DPO :</strong> dpo@pixelclash.fr</p>
              </div>
            </div>

            <div class="p-6 rounded-xl bg-bg-dark/40 backdrop-blur-md border border-neon-cyan/20">
              <h2 class="text-2xl font-bold text-text-light mb-4">2. Données collectées</h2>
              
              <h3 class="text-xl font-semibold text-neon-cyan mb-3">2.1 Données d'inscription</h3>
              <ul class="text-text-muted space-y-2 mb-4">
                <li>• Prénom et nom</li>
                <li>• Adresse email</li>
                <li>• Date de naissance</li>
                <li>• Ville de résidence</li>
                <li>• Nombre de participations à des tournois</li>
              </ul>

              <h3 class="text-xl font-semibold text-neon-cyan mb-3">2.2 Données de navigation</h3>
              <ul class="text-text-muted space-y-2">
                <li>• Adresse IP</li>
                <li>• Type de navigateur</li>
                <li>• Pages visitées</li>
                <li>• Durée de visite</li>
                <li>• Cookies Google Analytics</li>
              </ul>
            </div>

            <div class="p-6 rounded-xl bg-bg-dark/40 backdrop-blur-md border border-neon-cyan/20">
              <h2 class="text-2xl font-bold text-text-light mb-4">3. Finalités du traitement</h2>
              <p class="text-text-muted leading-relaxed mb-4">
                Vos données sont collectées pour :
              </p>
              <ul class="text-text-muted space-y-2">
                <li>• Gérer votre inscription à l'événement</li>
                <li>• Vous envoyer des informations sur l'événement</li>
                <li>• Améliorer nos services</li>
                <li>• Respecter nos obligations légales</li>
                <li>• Analyser le trafic du site (Google Analytics)</li>
              </ul>
            </div>

            <div class="p-6 rounded-xl bg-bg-dark/40 backdrop-blur-md border border-neon-cyan/20">
              <h2 class="text-2xl font-bold text-text-light mb-4">4. Base légale</h2>
              <p class="text-text-muted leading-relaxed mb-4">
                Le traitement de vos données repose sur :
              </p>
              <ul class="text-text-muted space-y-2">
                <li>• <strong class="text-neon-cyan">Consentement :</strong> inscription volontaire à l'événement</li>
                <li>• <strong class="text-neon-cyan">Exécution du contrat :</strong> gestion de votre participation</li>
                <li>• <strong class="text-neon-cyan">Intérêt légitime :</strong> amélioration de nos services</li>
                <li>• <strong class="text-neon-cyan">Obligation légale :</strong> conservation des données comptables</li>
              </ul>
            </div>

            <div class="p-6 rounded-xl bg-bg-dark/40 backdrop-blur-md border border-neon-cyan/20">
              <h2 class="text-2xl font-bold text-text-light mb-4">5. Destinataires des données</h2>
              <p class="text-text-muted leading-relaxed mb-4">
                Vos données peuvent être transmises à :
              </p>
              <ul class="text-text-muted space-y-2">
                <li>• L'équipe organisatrice de PIXEL CLASH</li>
                <li>• Formspark (traitement des formulaires)</li>
                <li>• Google Analytics (analyse de trafic)</li>
                <li>• AWS (hébergement)</li>
              </ul>
              <p class="text-text-muted leading-relaxed mt-4">
                Aucune donnée n'est vendue à des tiers.
              </p>
            </div>

            <div class="p-6 rounded-xl bg-bg-dark/40 backdrop-blur-md border border-neon-cyan/20">
              <h2 class="text-2xl font-bold text-text-light mb-4">6. Durée de conservation</h2>
              <ul class="text-text-muted space-y-2">
                <li>• <strong class="text-neon-cyan">Données d'inscription :</strong> 3 ans après l'événement</li>
                <li>• <strong class="text-neon-cyan">Données de navigation :</strong> 13 mois (Google Analytics)</li>
                <li>• <strong class="text-neon-cyan">Cookies :</strong> 13 mois maximum</li>
              </ul>
            </div>

            <div class="p-6 rounded-xl bg-bg-dark/40 backdrop-blur-md border border-neon-cyan/20">
              <h2 class="text-2xl font-bold text-text-light mb-4">7. Vos droits</h2>
              <p class="text-text-muted leading-relaxed mb-4">
                Conformément au RGPD, vous disposez des droits suivants :
              </p>
              
              <div class="space-y-3">
                <div class="p-4 rounded-lg bg-bg-dark/60 border border-neon-cyan/10">
                  <h3 class="text-lg font-semibold text-neon-cyan mb-2">Droit d'accès</h3>
                  <p class="text-text-muted text-sm">Obtenir une copie de vos données personnelles</p>
                </div>
                
                <div class="p-4 rounded-lg bg-bg-dark/60 border border-neon-cyan/10">
                  <h3 class="text-lg font-semibold text-neon-cyan mb-2">Droit de rectification</h3>
                  <p class="text-text-muted text-sm">Corriger vos données inexactes ou incomplètes</p>
                </div>
                
                <div class="p-4 rounded-lg bg-bg-dark/60 border border-neon-cyan/10">
                  <h3 class="text-lg font-semibold text-neon-cyan mb-2">Droit à l'effacement</h3>
                  <p class="text-text-muted text-sm">Demander la suppression de vos données</p>
                </div>
                
                <div class="p-4 rounded-lg bg-bg-dark/60 border border-neon-cyan/10">
                  <h3 class="text-lg font-semibold text-neon-cyan mb-2">Droit d'opposition</h3>
                  <p class="text-text-muted text-sm">Vous opposer au traitement de vos données</p>
                </div>
                
                <div class="p-4 rounded-lg bg-bg-dark/60 border border-neon-cyan/10">
                  <h3 class="text-lg font-semibold text-neon-cyan mb-2">Droit à la portabilité</h3>
                  <p class="text-text-muted text-sm">Récupérer vos données dans un format structuré</p>
                </div>
                
                <div class="p-4 rounded-lg bg-bg-dark/60 border border-neon-cyan/10">
                  <h3 class="text-lg font-semibold text-neon-cyan mb-2">Droit de limitation</h3>
                  <p class="text-text-muted text-sm">Limiter le traitement de vos données</p>
                </div>
              </div>

              <p class="text-text-muted leading-relaxed mt-4">
                Pour exercer ces droits, contactez-nous à : <a href="mailto:dpo@pixelclash.fr" class="text-neon-cyan hover:text-neon-magenta transition-colors font-medium">dpo@pixelclash.fr</a>
              </p>
            </div>

            <div class="p-6 rounded-xl bg-bg-dark/40 backdrop-blur-md border border-neon-cyan/20">
              <h2 class="text-2xl font-bold text-text-light mb-4">8. Sécurité des données</h2>
              <p class="text-text-muted leading-relaxed mb-4">
                Nous mettons en œuvre des mesures techniques et organisationnelles pour protéger vos données :
              </p>
              <ul class="text-text-muted space-y-2">
                <li>• Chiffrement HTTPS (SSL/TLS)</li>
                <li>• Hébergement sécurisé AWS</li>
                <li>• Accès restreint aux données</li>
                <li>• Sauvegardes régulières</li>
                <li>• Surveillance des accès</li>
              </ul>
            </div>

            <div class="p-6 rounded-xl bg-bg-dark/40 backdrop-blur-md border border-neon-cyan/20">
              <h2 class="text-2xl font-bold text-text-light mb-4">9. Cookies</h2>
              <p class="text-text-muted leading-relaxed mb-4">
                Ce site utilise les cookies suivants :
              </p>
              <ul class="text-text-muted space-y-2">
                <li>• <strong class="text-neon-cyan">Google Analytics :</strong> analyse de trafic (anonymisé)</li>
                <li>• <strong class="text-neon-cyan">Cookies techniques :</strong> fonctionnement du site</li>
              </ul>
              <p class="text-text-muted leading-relaxed mt-4">
                Vous pouvez désactiver les cookies dans les paramètres de votre navigateur.
              </p>
            </div>

            <div class="p-6 rounded-xl bg-bg-dark/40 backdrop-blur-md border border-neon-cyan/20">
              <h2 class="text-2xl font-bold text-text-light mb-4">10. Réclamation</h2>
              <p class="text-text-muted leading-relaxed">
                Si vous estimez que vos droits ne sont pas respectés, vous pouvez introduire une réclamation auprès de la CNIL : <a href="https://www.cnil.fr" target="_blank" rel="noopener noreferrer" class="text-neon-cyan hover:text-neon-magenta transition-colors">www.cnil.fr</a>
              </p>
            </div>

            <div class="p-6 rounded-xl bg-gradient-to-br from-neon-magenta/10 via-neon-cyan/10 to-neon-magenta/10 border border-neon-cyan/30">
              <h2 class="text-xl font-bold text-text-light mb-3">Contact DPO</h2>
              <p class="text-text-muted mb-4">
                Pour toute question sur la protection de vos données :
              </p>
              <div class="space-y-2 text-text-muted">
                <p><strong class="text-neon-cyan">Email :</strong> <a href="mailto:dpo@pixelclash.fr" class="text-neon-cyan hover:text-neon-magenta transition-colors">dpo@pixelclash.fr</a></p>
                <p><strong class="text-neon-cyan">Courrier :</strong> DPO - PIXEL CLASH SARL, 123 Avenue des Champs-Élysées, 75008 Paris</p>
              </div>
            </div>
          </div>

        </div>
      </article>
    </div>

    <Footer />

  </div>
</LayoutRedesign>
