---
import LayoutRedesign from '../layouts/LayoutRedesign.astro';
import { GridBackground } from '../components/redesign/layout/GridBackground';
import Header from '../components/redesign/layout/Header';
import Footer from '../components/redesign/layout/Footer.astro';
---

<LayoutRedesign 
  title="404 - Page Non Trouvée"
  description="La page que vous recherchez n'existe pas ou a été déplacée."
>
  <div class="min-h-screen bg-bg-dark text-text-light">
    
    <Header client:load currentPath={Astro.url.pathname} />
    <GridBackground client:only="react" />
    
    <div class="pt-16">
  <!-- Hero 404 Synthwave -->
  <section class="relative bg-gradient-to-br from-bg-dark via-bg-dark-accent to-bg-dark text-white py-20 md:py-28 overflow-hidden">
    <!-- Gradient Orbs -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-neon-cyan rounded-full blur-3xl opacity-20"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-neon-magenta rounded-full blur-3xl opacity-20"></div>
    
    <div class="container mx-auto px-4 relative z-10 text-center">
      <!-- Glitch Effect 404 -->
      <div class="relative mb-8">
        <h1 
          class="font-gaming text-8xl md:text-9xl font-bold drop-shadow-[0_0_30px_rgba(0,217,255,0.8)]"
          aria-label="Erreur 404"
        >
          404
        </h1>
        
        <!-- Glitch layers (décoratives uniquement) -->
        <div 
          class="absolute inset-0 font-gaming text-8xl md:text-9xl font-bold text-neon-cyan/50 animate-glitch-1 pointer-events-none"
          aria-hidden="true"
        >
          404
        </div>
        <div 
          class="absolute inset-0 font-gaming text-8xl md:text-9xl font-bold text-neon-magenta/50 animate-glitch-2 pointer-events-none"
          aria-hidden="true"
        >
          404
        </div>
      </div>

      <!-- Message d'erreur -->
      <h2 class="text-3xl md:text-4xl font-bold mb-4 uppercase tracking-wide">
        Game Over
      </h2>
      
      <p class="text-lg md:text-xl text-gray-200 mb-8 max-w-lg mx-auto leading-relaxed">
        La page que vous recherchez<br/>n'existe pas ou a été déplacée.<br/><br/>
        Peut-être qu'elle s'est perdue dans les pixels...
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">
        <!-- Bouton principal : Retour accueil -->
        <a
          href="/"
          class="group inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-neon-magenta to-neon-cyan hover:from-neon-magenta/90 hover:to-neon-cyan/90 text-white font-bold rounded-lg text-lg shadow-lg shadow-neon-magenta/50 hover:shadow-neon-cyan/70 transition-all duration-300"
        >
          <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Retour à l'accueil
        </a>

        <!-- Bouton secondaire : Tournoi -->
        <a
          href="/tournament"
          class="inline-flex items-center gap-2 px-8 py-4 bg-transparent border-2 border-neon-cyan/30 hover:bg-neon-cyan/10 hover:border-neon-cyan/50 text-neon-cyan font-bold rounded-lg text-lg transition-all duration-300"
        >
          Voir le tournoi
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
      </div>

      <!-- Liens utiles -->
      <nav class="flex flex-wrap gap-4 justify-center text-sm text-white/80">
        <a href="/about" class="hover:text-white transition-colors">
          Notre histoire
        </a>
        <span class="text-white/50">•</span>
        <a href="/blog" class="hover:text-white transition-colors">
          Blog
        </a>
        <span class="text-white/50">•</span>
        <a href="/cgu" class="hover:text-white transition-colors">
          CGU
        </a>
        <span class="text-white/50">•</span>
        <a href="/politique-confidentialite" class="hover:text-white transition-colors">
          Confidentialité
        </a>
      </nav>
    </div>
  </section>
    </div>

    <Footer />
  </div>
</LayoutRedesign>

<style>
  @keyframes glitch-1 {
    0%, 100% {
      transform: translate(0);
    }
    20% {
      transform: translate(-2px, 2px);
    }
    40% {
      transform: translate(-2px, -2px);
    }
    60% {
      transform: translate(2px, 2px);
    }
    80% {
      transform: translate(2px, -2px);
    }
  }

  @keyframes glitch-2 {
    0%, 100% {
      transform: translate(0);
    }
    20% {
      transform: translate(2px, -2px);
    }
    40% {
      transform: translate(2px, 2px);
    }
    60% {
      transform: translate(-2px, -2px);
    }
    80% {
      transform: translate(-2px, 2px);
    }
  }

  .animate-glitch-1 {
    animation: glitch-1 0.3s infinite;
  }

  .animate-glitch-2 {
    animation: glitch-2 0.3s infinite reverse;
  }
</style>
