---
/**
 * Hero Section - Homepage Redesign (Astro Pure)
 * 
 * Converti de React → Astro pour performance
 * - 0 KB JavaScript (vs 5 KB + 136 KB React)
 * - Rendu statique SSG
 * - Icons Lucide en SVG inline
 * 
 * @performance Gain estimé : +8 points Lighthouse
 */

import { Calendar, MapPin } from "lucide-react";
import { heroData } from "../../../data/redesign/home";
import OptimizedImage from "../common/OptimizedImage.astro";
import CTAButton from "../common/CTAButton";
---

<section class="relative min-h-[700px] flex items-center overflow-visible py-20">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0">
    <OptimizedImage
      src={heroData.image.src}
      srcset={heroData.image.srcset}
      alt={heroData.image.alt}
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a1f] via-[#0a0a1f]/95 to-[#0a0a1f]/80" />
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#0a0a1f]" />
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-4xl">
      <!-- Eyebrow - Brand Presentation -->
      <div class="inline-block mb-4">
        <span class="text-neon-magenta tracking-widest text-sm uppercase font-bold">
          {heroData.eyebrow}
        </span>
      </div>

      <!-- Main H1 - SEO Optimized -->
      <h1 class="mb-6 leading-none">
        <span class="block text-5xl md:text-7xl lg:text-8xl tracking-tight mb-4 text-text-light font-bold">
          {heroData.title}
        </span>
        <span class="block text-5xl md:text-7xl lg:text-8xl tracking-tight font-bold">
          <span class="bg-gradient-to-r from-neon-cyan via-neon-magenta to-neon-cyan bg-clip-text text-transparent">
            {heroData.titleHighlight}
          </span>
        </span>
      </h1>

      <!-- Subtitle - Value Proposition -->
      <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-3xl leading-relaxed">
        Le plus grand championnat de jeux arcade classiques en France.
        <br />
        125 joueurs, 15 000€ de récompense, 3 jours de compétition intense.
      </p>

      <!-- Date & Location Badges - Critical Info Above Fold -->
      <div class="flex flex-wrap gap-3 mb-8">
        <div class="px-6 py-4 rounded-xl bg-[#0a0a1f]/70 border border-cyan-500/40 backdrop-blur-lg flex items-center gap-3 shadow-lg shadow-cyan-500/20">
          <Calendar className="w-6 h-6 text-[#00f3ff]" />
          <div>
            <div class="text-xs text-gray-300 uppercase font-semibold">
              {heroData.date.label}
            </div>
            <div class="text-white text-lg font-semibold">{heroData.date.value}</div>
          </div>
        </div>
        <div class="px-6 py-4 rounded-xl bg-[#0a0a1f]/70 border border-pink-500/40 backdrop-blur-lg flex items-center gap-3 shadow-lg shadow-pink-500/20">
          <MapPin className="w-6 h-6 text-[#ff00ff]" />
          <div>
            <div class="text-xs text-gray-300 uppercase font-semibold">
              {heroData.location.label}
            </div>
            <div class="text-white text-lg font-semibold">{heroData.location.value}</div>
          </div>
        </div>
      </div>

      <!-- Primary CTA -->
      <div class="mb-4">
        <CTAButton client:load variant="primary">
          {heroData.ctaPrimary.text}
        </CTAButton>
      </div>
    </div>
  </div>
</section>
